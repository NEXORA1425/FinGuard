# ==========================================
# FinGuard Environment Configuration Template
# ==========================================

# 1. Google Gemini AI Engine
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Supabase Private Storage & Service Role Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 3. Server Hosting Configuration
PORT=3000
NODE_ENV=development

# 4. Application Base URL
APP_URL=http://localhost:3000
